{
  "name": "one-sheet",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/physics.test.js tests/theory.test.js tests/cooldown.test.js tests/papers.test.js",
    "golden": "node tools/run-legacy.cjs",
    "serve": "python3 -m http.server 8080",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-one-sheet \"node --test --test-concurrency=1 tests/rules.test.js tests/firebase.test.js && npx playwright test tests/multiplayer.spec.js\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-one-sheet"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.56.1",
    "firebase": "12.19.0",
    "firebase-tools": "^15.32.1"
  }
}
